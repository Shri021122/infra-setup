################################################################################
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to git — it contains secrets.
################################################################################

# ─── Proxmox Connection (API-token only — no SSH required) ────────────────────
proxmox_api_url      = "https://YOUR_PROXMOX_IP:8006/api2/json"
proxmox_username     = "terraform@pve"
# proxmox_password is set via: export TF_VAR_proxmox_password="your-password"
# Preferred: export TF_VAR_proxmox_api_token="terraform@pve!tokenid=UUID"
proxmox_tls_insecure = false
proxmox_node         = "pve"   # Your Proxmox node name

# ─── Shared cloud-init snippet (one-time admin upload, then referenced) ───────
# An admin uploads terraform/proxmox/snippets/k8s-common.yaml to Proxmox ONCE
# (Datacenter → Storage → local → Snippets → Upload, or scp during initial
# host setup). Then every cluster Terraform runs reference it via this file ID
# — no SSH-from-Terraform needed. Leave empty to skip the snippet entirely
# (VMs still get user/IP/DNS via API blocks; just no package preinstall etc.)
#
# DANGER: setting this on an *existing* deployed cluster forces VM recreation
# (the provider marks user_data_file_id as ForceNew). Only set on FRESH
# deploys or when you intend to re-provision.
shared_cloud_init_snippet_file_id = ""   # e.g. "local:snippets/k8s-common.yaml"

# ─── Network ──────────────────────────────────────────────────────────────────
network_bridge      = "vmbr0"
network_subnet_cidr = "192.168.10.0/24"
network_gateway     = "192.168.10.1"
dns_servers         = ["192.168.10.1", "8.8.8.8"]
domain_name         = "cluster.internal"
vlan_tag            = 0   # 0 = untagged; set to your VLAN ID if needed
control_plane_vip   = "192.168.10.100"   # Free IP in your subnet (not assigned to any node)
control_plane_vip_interface = "eth0"

# ─── VM Template ──────────────────────────────────────────────────────────────
vm_template_id      = 9000   # Your Ubuntu 22.04 cloud-init template VM ID
vm_template_storage = "local-lvm"

# ─── SSH Access ───────────────────────────────────────────────────────────────
# Paste your SSH public key here (or leave blank to auto-generate)
vm_ssh_public_key       = "ssh-ed25519 AAAAC3... your-key-here"
vm_ssh_private_key_path = "~/.ssh/id_rsa"
vm_user                 = "ubuntu"
vm_cpu_type             = "x86-64-v2-AES"  # Or "host" for single-node Proxmox

# ─── Master Nodes ─────────────────────────────────────────────────────────────
master_count            = 3
master_vm_id_start      = 300
master_cpu_cores        = 4
master_cpu_sockets      = 1
master_memory_mb        = 8192    # 8 GB
master_disk_size_gb     = 50
master_etcd_disk_size_gb = 20
master_disk_storage     = "local-lvm"
master_name_prefix      = "rke2-master"
master_ip_addresses     = [
  "192.168.10.101",
  "192.168.10.102",
  "192.168.10.103",
]

# ─── Worker Nodes ─────────────────────────────────────────────────────────────
# To add workers: increment worker_count and add IPs — run terraform apply
worker_count            = 2
worker_vm_id_start      = 310
worker_cpu_cores        = 8
worker_cpu_sockets      = 1
worker_memory_mb        = 16384   # 16 GB
worker_disk_size_gb     = 100
worker_data_disk_size_gb = 200
worker_disk_storage     = "local-lvm"
worker_name_prefix      = "rke2-worker"
worker_ip_addresses     = [
  "192.168.10.111",
  "192.168.10.112",
]

# ─── RKE2 ─────────────────────────────────────────────────────────────────────
rke2_version     = "v1.29.4+rke2r1"
rke2_cni         = "cilium"
rke2_cluster_cidr = "10.42.0.0/16"
rke2_service_cidr = "10.43.0.0/16"
rke2_cluster_dns  = "10.43.0.10"
cluster_name     = "rke2-prod"

# ─── Metadata ─────────────────────────────────────────────────────────────────
environment = "production"
tags = {
  managed_by  = "terraform"
  cluster     = "rke2-prod"
  environment = "production"
  team        = "devops"
}

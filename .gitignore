# Secrets — NEVER commit these
.secrets/
# Per-cluster tfvars under clusters/ ARE the cluster definition — we WANT them
# tracked. The `!` re-includes overrides the broad `*.tfvars` rule above.
# (gitignore does not support inline `#` comments — keep them on their own line.)
*.tfvars
!*.tfvars.example
!clusters/**/*.tfvars
*.pem
*.key
*.crt
*.p12
*.pfx
kubeconfig*.yaml
kubeconfigs/*.yaml
rke2/configs/inventory.ini
rke2/configs/master-*-config.yaml
rke2/configs/worker-*-config.yaml

# Per-cluster generated artifacts — never tracked
clusters/*/tfstate/
clusters/*/kubeconfig.yaml
clusters/*/rbac-kubeconfigs/
clusters/*/handoff.md

# Terraform state — use remote backend in production
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfplan

# OS / Editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/settings.json
